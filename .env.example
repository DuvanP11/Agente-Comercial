# Copia a .env.local (local) o configura en Vercel > Settings > Environment Variables.
# Ninguna variable lleva prefijo NEXT_PUBLIC_: nada de esto debe llegar al navegador.

# --- Acceso a la app (obligatorias en producción; sin ellas la app responde 503) ---
APP_PASSWORD=
# Correo (o usuario) del administrador: entra con APP_PASSWORD y es el único que crea usuarios y restablece contraseñas. Si no se define, el usuario es «admin».
ADMIN_EMAIL=
AUTH_SECRET=            # cadena aleatoria de >= 24 caracteres (p.ej. `openssl rand -hex 32`)

# --- Base de datos ---
# PostgreSQL gestionado. Vacía en desarrollo => PGlite local en ./.pglite (NO usar en producción).
DATABASE_URL=

# --- Conectores ---
# Google Places API (New). Créala restringida a esa API. Sin ella, "Buscar clientes" queda desactivado.
GOOGLE_PLACES_API_KEY=

# --- IA (opcional; sin esto los agentes con IA quedan desactivados) ---
# Cualquier API compatible con OpenAI. La URL se usa tal cual (sin añadir /v1). Ejemplos:
#   https://api.openai.com/v1 · https://api.groq.com/openai/v1 · https://openrouter.ai/api/v1
#   https://generativelanguage.googleapis.com/v1beta/openai · http://localhost:11434/v1 (Ollama, sin clave)
# Verifica las condiciones vigentes de cada proveedor (incluido su plan gratuito) antes de enviar información de negocios.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=       # opcional, entre 5000 y 120000 (por defecto 45000)

# Respaldos opcionales, en orden: si el principal falla o agota su cupo, se pasa al siguiente (queda anotado).
# Mismas 3 variables con prefijo AI2_ (respaldo 1) y AI3_ (respaldo 2).
# Ollama local NO es alcanzable desde Vercel: solo sirve si ejecutas la app en tu propio computador.
#   AI2_BASE_URL=http://localhost:11434/v1
#   AI2_MODEL=llama3.1:latest
#   AI2_API_KEY=           # no necesaria con Ollama
AI2_BASE_URL=
AI2_MODEL=
AI2_API_KEY=
AI3_BASE_URL=
AI3_MODEL=
AI3_API_KEY=

# Gmail (envío desde la plataforma, por usuario). Cargar en Vercel como Sensitive.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GMAIL_TOKEN_KEY=          # opcional: clave propia para cifrar los tokens (si no, se deriva de AUTH_SECRET)
# GMAIL_DAILY_CAP=150       # opcional: tope diario de correos por persona (máx 1500)
# GOOGLE_OAUTH_REDIRECT_URI= # opcional: si no, https://<host>/api/gmail/callback

# WhatsApp Business (Bix). Cargar en Vercel como Sensitive.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=     # lo inventas tú; el mismo valor va en la configuración del webhook de Meta
# WHATSAPP_APP_SECRET=       # secreto de la app de Meta (firma del webhook)
# WHATSAPP_TEMPLATE_NAME=    # plantilla aprobada de saludo, con {{1}} = nombre del negocio
# WHATSAPP_TEMPLATE_LANG=es
# BIX_DAILY_CAP=100
# GOOGLE_CHAT_WEBHOOK_URL=   # opcional: también se puede pegar en la pantalla Bix
