# Copia a .env.local (local) o configura en Vercel > Settings > Environment Variables.
# Ninguna variable lleva prefijo NEXT_PUBLIC_: nada de esto debe llegar al navegador.

# --- Acceso a la app (obligatorias en producción; sin ellas la app responde 503) ---
APP_PASSWORD=
AUTH_SECRET=            # cadena aleatoria de >= 24 caracteres (p.ej. `openssl rand -hex 32`)

# --- Base de datos ---
# PostgreSQL gestionado. Vacía en desarrollo => PGlite local en ./.pglite (NO usar en producción).
DATABASE_URL=

# --- Conectores ---
# Google Places API (New). Créala restringida a esa API. Sin ella, "Buscar clientes" queda desactivado.
GOOGLE_PLACES_API_KEY=

# --- IA (opcional; sin esto los agentes con IA quedan desactivados) ---
# Cualquier API compatible con OpenAI. La URL se usa tal cual (sin añadir /v1). Ejemplos:
#   https://api.openai.com/v1 · https://api.groq.com/openai/v1 · https://openrouter.ai/api/v1
#   https://generativelanguage.googleapis.com/v1beta/openai · http://localhost:11434/v1 (Ollama, sin clave)
# Verifica las condiciones vigentes de cada proveedor (incluido su plan gratuito) antes de enviar información de negocios.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=       # opcional, entre 5000 y 120000 (por defecto 45000)
